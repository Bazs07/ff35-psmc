+   /* There's no standard way to compute the machine or isa number
+      so we leave it to the target.  */
+ #ifdef CGEN_COMPUTE_MACH
+   mach = CGEN_COMPUTE_MACH (info);
+ #else
+   mach = info->mach;
+ #endif
+ 
+ #ifdef CGEN_COMPUTE_ISA
+   isa = CGEN_COMPUTE_ISA (info);
+ #else
+   isa = info->insn_sets;
+ #endif
