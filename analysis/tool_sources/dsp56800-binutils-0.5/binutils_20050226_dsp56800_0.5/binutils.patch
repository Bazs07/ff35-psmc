+         \opc \par X:(R0)+N,Y0 X:(R3)+,X0         
+         \opc \par X:(R0)+N,Y0 X:(R3)-,X0         
+         \opc \par X:(R1)+,Y0 X:(R3)+,X0         
+         \opc \par X:(R1)+,Y0 X:(R3)-,X0         
+         \opc \par X:(R1)+N,Y0 X:(R3)+,X0         
+         \opc \par X:(R1)+N,Y0 X:(R3)-,X0         
+ 
+         \opc \par X:(R0)+,Y1 X:(R3)+,X0         
+         \opc \par X:(R0)+,Y1 X:(R3)-,X0         
+         \opc \par X:(R0)+N,Y1 X:(R3)+,X0         
+         \opc \par X:(R0)+N,Y1 X:(R3)-,X0         
+         \opc \par X:(R1)+,Y1 X:(R3)+,X0         
+         \opc \par X:(R1)+,Y1 X:(R3)-,X0         
+         \opc \par X:(R1)+N,Y1 X:(R3)+,X0         
+         \opc \par X:(R1)+N,Y1 X:(R3)-,X0         
