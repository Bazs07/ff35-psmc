+ /* place the imm16 operand to correct place */
+ bfd_reloc_status_type
+ dsp56800_elf_reloc (input_bfd,
+ 						  reloc_entry,
+ 						  symbol,
+ 						  data,
+ 						  input_section,
+ 						  output_bfd,
+ 						  error_message,
+ 						  offset)
+      bfd *input_bfd ATTRIBUTE_UNUSED;
+      arelent *reloc_entry;
+      asymbol *symbol ATTRIBUTE_UNUSED;
+      PTR data ATTRIBUTE_UNUSED;
+      asection *input_section ATTRIBUTE_UNUSED;
+      bfd *output_bfd ATTRIBUTE_UNUSED;
+      char **error_message ATTRIBUTE_UNUSED;
+ 	  short offset ATTRIBUTE_UNUSED;
+ {
+   /* add offset to put data to correct place */
+   reloc_entry->address += offset;
+   return bfd_reloc_continue;
+ }
+ 
