+ .macro X_or_imm_FDD insn
+         FDD_BOTH \insn,X:(SP-<<1)
+         FDD_BOTH \insn,X:(SP-<<23)
+         FDD_BOTH \insn,X:<<1
+         FDD_BOTH \insn,X:<<23
+         FDD_BOTH \insn,X:$aaaa
+         FDD_BOTH \insn,X:$5555
+         FDD_LAST \insn,#<<1
+         FDD_LAST \insn,#<<23
+         FDD_LAST \insn,#$aaaa
+         FDD_LAST \insn,#$5555
+ .endm
+ 
+ 
+ .macro imm_to_any insn
+        DDDDD_LAST \insn,#$aaaa
+        DDDDD_LAST \insn,#$5555
+        \insn #$aaaa,x:(r2+<<1)
+        \insn #$aaaa,x:(r2+<<23)
+        \insn #$aaaa,x:(sp-<<1)
+        \insn #$aaaa,x:(sp-<<23)
+        \insn #$5555,x:<<1
+        \insn #$5555,x:<<23
+        \insn #$5555,x:23
+        \insn #$5555,x:$aaaa
+ .endm
