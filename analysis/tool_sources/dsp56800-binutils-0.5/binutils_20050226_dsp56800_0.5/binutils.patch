+ .macro move_xri_reg ri
+        DDDDD_BOTH move,x:(\ri)
+        DDDDD_BOTH move,x:(\ri)+
+        DDDDD_BOTH move,x:(\ri)-
+        DDDDD_BOTH move,x:(\ri)+N
