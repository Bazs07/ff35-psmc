-   \hangindent=1in
-   \hangafter=1
-   \noindent\hskip\secondaryindent\hbox{#1}\indexdotfill
-   \ifpdf
-     \pdfgettoks#2.\ \the\toksA % The page number ends the paragraph.
-   \else
-     #2
-   \fi
-   \par
- }}
