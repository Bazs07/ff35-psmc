+        DDDDD_MID \insn,#$0055,-16
+        \insn #$aa00,x:(r2+<<1),1
+        \insn #$00aa,x:(r2+<<23),-1
+        \insn #$aa00,x:(sp-<<1),16
+        \insn #$00aa,x:(sp-<<23),-16
+        \insn #$5500,x:<<1,0
+        \insn #$0055,x:<<23,27
+        \insn #$5500,x:23,-27
+        \insn #$0055,x:$aaaa,3
+ .endm
