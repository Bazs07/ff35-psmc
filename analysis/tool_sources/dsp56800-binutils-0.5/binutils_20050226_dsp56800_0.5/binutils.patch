- % @letterpaper (the default).
- \def\letterpaper{{\globaldefs = 1
-   \parskip = 3pt plus 2pt minus 1pt
-   \textleading = 13.2pt
-   %
-   % If page is nothing but text, make it come out even.
-   \internalpagesizes{46\baselineskip}{6in}%
