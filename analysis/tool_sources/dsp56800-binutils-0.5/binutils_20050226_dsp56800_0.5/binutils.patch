+ ; -*- mode: text; -*-
+ 
+ ;; Notation
+ 
+ ;; Registers
+ ;; HHH - A,B,A1,B1,X0,Y0,Y1
+ ;; HHHH - A,B,A1,B1,X0,Y0,Y1,R0-R3,N
+ ;; DDDDD - A,A2,A1,A0,B,B2,B1,B0,X0,Y0,Y1,R0-R3,N,SP,M01,OMR,SR,LA,LC,HWS
+ ;; Rn - R0-R3,SP
+ ;; Rj - R0-R3
+ ;; N - N
+ ;; M01 - M01
+ ;; FDD - A,B,X0,Y0,Y1
+ ;; F1DD - A1,B1,X0,Y0,Y1
+ ;; DD - X0,Y0,Y1
+ ;; F - A,B
+ ;; F1 - A1,B1
+ ;; Y - [Y1 Y0]
+ 
+ ;; Addressing
+ ;; ea - effective address
+ ;; eax - effective address on X bus
+ ;; xxxx - 16bit absolute address
+ ;; pp - 6bit one extended short I/O address
+ ;; aa - 6bit zero extended absolute address
+ ;; <..> - content of address in brackets
+ ;; X: - X memory reference
+ ;; P: - P memory reference
+ ;; << - I/O short or absolute address force operator
+ ;; > - long addressing mode operator
+ ;; # - immediate addressing mode operator
+ ;; #> - immediate long addressing mode operator
+ ;; #< - immediate short addressing mode operator
+ 
+ ;; Data
+ ;; S,Sn - source operand register
+ ;; D,Dn - destination operand register
+ ;; #xx - immediate data 7bit for move 6bits for do/rep
+ ;; #xxxx - 16bit immediate data
+ ;; #ii00 - 8bit immediate data mask in upper byte
+ ;; #00ii - 8bit immediate data mask in lower byte
+ ;; <OFFSET7> - 7bit signed PC relative offset
+ 
+ 
+ ;; all opcodes tests
+ ;; Note: commented out insns are not yes supported!
+ 
+ 
+ ;; Macros expanding operands
+ 
+ .macro GET_2_OP_REGS mac insn
+         \mac \insn "Y1,X0"
+         \mac \insn "Y0,X0"
+         \mac \insn "Y1,Y0"
+         \mac \insn "Y0,Y0"
+         \mac \insn "A1,Y0"
+         \mac \insn "B1,Y1"
+ .endm
+ 
+ .macro GET_2_OP_REGS_SWITCH mac insn
+         \mac \insn "X0,Y1"
+         \mac \insn "X0,Y0"
+         \mac \insn "Y0,Y1"
+         \mac \insn "Y0,Y0"
+         \mac \insn "Y0,A1"
+         \mac \insn "Y1,B1"
+ .endm
+ 
+ .macro GET_2_OP_REGS_NEG mac insn
+         \mac \insn "-Y1,X0"
+         \mac \insn "-Y0,X0"
+         \mac \insn "-Y1,Y0"
+         \mac \insn "-Y0,Y0"
+         \mac \insn "-A1,Y0"
+         \mac \insn "-B1,Y1"
+ .endm
+ 
+ .macro F_LAST_2_OP_REGS insn
+        GET_2_OP_REGS F_LAST,\insn
+ .endm
+ 
+ .macro F insn
+         \insn A
+         \insn B
+ .endm
+ 
+ .macro F_LAST insn par
+         \insn \par,A
+         \insn \par,B
+ .endm
+ 
+ .macro F_FIRST insn par
+         \insn A,\par
+         \insn B,\par
+ .endm
+ 
+ .macro F_MID insn par1 par2
+         \insn \par1,A,\par2
+         \insn \par1,B,\par2
+ .endm
+ 
+ .macro DD_LAST insn par
+         \insn \par,X0
+         \insn \par,Y0
+         \insn \par,Y1
+ .endm
+ 
+ .macro DD_FIRST insn par
