+ static void
+ print_keyword (CGEN_CPU_DESC cd ATTRIBUTE_UNUSED,
+ 	       void *dis_info,
+ 	       CGEN_KEYWORD *keyword_table,
+ 	       long value,
+ 	       unsigned int attrs ATTRIBUTE_UNUSED)
