+         tstw x:$aa55
+         tstw x:$1234
+ 
+         tstw x:$ffff
+         tstw x:$ffe0
+ 
+         tstw x:$1
+         tstw x:$15
+ 
+         tstw x:(r2+<<1)
+         tstw x:(r2+<<27)
+         tstw x:(sp-<<1)
+         tstw x:(sp-<<27)
+ .endm
