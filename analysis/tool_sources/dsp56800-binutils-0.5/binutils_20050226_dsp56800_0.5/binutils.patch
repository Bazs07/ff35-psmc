- \catcode`\"=\active
- \def\activedoublequote{{\tt\char34}}
- \let"=\activedoublequote
- \catcode`\~=\active
- \def~{{\tt\char126}}
- \chardef\hat=`\^
- \catcode`\^=\active
- \def^{{\tt \hat}}
- 
- \catcode`\_=\active
- \def_{\ifusingtt\normalunderscore\_}
- % Subroutine for the previous macro.
- \def\_{\leavevmode \kern.07em \vbox{\hrule width.3em height.1ex}\kern .07em }
- 
- \catcode`\|=\active
- \def|{{\tt\char124}}
- \chardef \less=`\<
- \catcode`\<=\active
- \def<{{\tt \less}}
- \chardef \gtr=`\>
- \catcode`\>=\active
- \def>{{\tt \gtr}}
- \catcode`\+=\active
- \def+{{\tt \char 43}}
- \catcode`\$=\active
- \def${\ifusingit{{\sl\$}}\normaldollar}%$ font-lock fix
