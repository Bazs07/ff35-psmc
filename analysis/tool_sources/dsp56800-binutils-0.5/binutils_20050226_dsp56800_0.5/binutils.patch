+         .text
+ _opcodes_all:
+         ;; abs
+         SPM abs A
+         SPM abs B
+ 
+         ;; adc
+         adc Y,A
+         adc Y,B
+ 
+         ;; add
+         SPM add "X0,A"
+         SPM add "Y0,A"
+         SPM add "Y1,A"
+         SPM add "X0,B"
+         SPM add "Y0,B"
+         SPM add "Y1,B"
+         SPM add "A,B"
+         SPM add "B,A"
+ 
+         DPM add "X0,A"
+         DPM add "Y0,A"
+         DPM add "Y1,A"
+         DPM add "X0,B"
+         DPM add "Y0,B"
+         DPM add "Y1,B"
+ 
+         DD_FDD add
+         F1_DD add
+         NF_F_and_Y_F add
+         X_or_imm_FDD add
+ 
+         ;; and
+         DD_FDD and
+         F1_DD and
+         
+         ;; andc
+         ;; this is alias to BFCLR with mask inverted
+ 
+         ;; asl
+         FDD asl
+         SPM asl "A"
+         SPM asl "B"
+ 
+         ;; asll
+         FDD_LAST_2_OP_REGS asll
+ 
+         ;; asr
+         FDD asr
+         SPM asr "A"
+         SPM asr "B"
+ 
+         ;; asrac
+         F_LAST_2_OP_REGS asrac
+ 
+         ;; asrr
+         FDD_LAST_2_OP_REGS asrr
+ 
+         ;; bcc
+         XCC b,-1
+         XCC b,1
+         XCC b,27
+         XCC b,-27
+         XCC b,0
+ 
+         ;; bfchg
+         imm_to_any bfchg
+ 
+         ;; bfclr
+         imm_to_any bfclr
+ 
+         ;; bfset
+         imm_to_any bfset
+ 
+         ;; bftsth
+         imm_to_any bftsth
+ 
+         ;; bftsth
+         imm_to_any bftstl
+ 
+         ;; bra
+         bra -1
+         bra 1
+         bra 27
+         bra -27
+         bra 0
+ 
+         ;; brclr
+         BRxxx brclr
+ 
+         ;; brset
+         BRxxx brset
+ 
+         ;; clr
+         clr A
+         clr B
+         ; following insn should be used as move #0,<reg>
+         ;F1DD clr
+         ;RJ clr
+         ;clr N
+         SPM clr "A"
+         SPM clr "B"
+ 
+         ;; cmp
+         SPM cmp "X0,A"
+         SPM cmp "Y0,A"
+         SPM cmp "Y1,A"
+         SPM cmp "X0,B"
+         SPM cmp "Y0,B"
+         SPM cmp "Y1,B"
+         SPM cmp "A,B"
+         SPM cmp "B,A"
+ 
+         DD_FDD cmp
+         F1_DD cmp
+         cmp A,B
+         cmp B,A
+ 
+         FDD_LAST cmp,X:(SP-<<1)
+         FDD_LAST cmp,X:(SP-<<23)
+         FDD_LAST cmp,X:<<1
+         FDD_LAST cmp,X:<<23
+         FDD_LAST cmp,X:$aaaa
+         FDD_LAST cmp,X:$5555
+         FDD_LAST cmp,#<<1
+         FDD_LAST cmp,#<<23
+         FDD_LAST cmp,#$aaaa
+         FDD_LAST cmp,#$5555
+ 
+         ;; debug
+         debug
+ 
+         ;; dec
+         FDD dec
+         dec x:(sp-<<1)
+         dec x:(sp-<<15)
+         dec x:<<-1
+         dec x:<<23
+         dec x:$aa55
+         dec x:$12
+         SPM dec "A"
+         SPM dec "B"
+ 
+         ;; div
+         DD_FIRST div,A
+         DD_FIRST div,B
+ 
+         ;; do
+         do #1,$1234
+         do #23,$4321
+         DDDDD_FIRST do,$5512
+ 
+         ;; enddo
+         enddo
+ 
+         ;; eor
+         DD_FDD eor
+         F1_DD eor
+ 
+         ;; eorc        
+         ; mapped to bfchg with mask not inverted
+ 
+         ;; illegal
+         illegal
+ 
+         ;; impy
+         FDD_LAST_2_OP_REGS impy
+ 
+         ;; inc
+         FDD inc
+         inc x:(sp-<<1)
+         inc x:(sp-<<15)
+         inc x:<<-1
+         inc x:<<23
+         inc x:$aa55
+         inc x:$12
+         SPM inc "A"
+         SPM inc "B"
+ 
+         ;; jcc
+         XCC j,$aa55
+         XCC j,1        
+ 
+         ;; jmp
+         jmp 1
+         jmp $aa55
+         
+         ;; jsr
+         jsr 1
+         jsr $aa55
+ 
+         ;; lea
+         lea (R0)+
+         lea (R1)+
+         lea (R2)+
+         lea (R3)+
+         lea (SP)+
+         lea (R0)-
+         lea (R1)-
+         lea (R2)-
+         lea (R3)-
+         lea (SP)-
+         lea (R0)+N
+         lea (R1)+N
+         lea (R2)+N
+         lea (R3)+N
+         lea (SP)+N
+         lea (R2+<<1)
+         lea (R2+<<23)
+         lea (SP-<<1)
+         lea (SP-<<23)
+         lea (R0+$aa55)
+         lea (R1+1)
+         lea (R2+1234)
+         lea (R3+$55)
+         lea (SP+$aa)
+         
+         ;; lsl
