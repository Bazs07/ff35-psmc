+         HHHH_LAST move,#1       
+         HHHH_LAST move,#27
+         DDDDD_LAST move,#$aa55
+         DDDDD_LAST move,#$1234
+         move #$aaaa,x:(r2+<<1)
+         move #$5555,x:(r2+<<27)
+         move #$1010,x:(sp-<<1)
+         move #$9876,x:(sp-<<27)
