- % Define macros to output various characters with catcode for normal text.
- \catcode`\"=\other
- \catcode`\~=\other
- \catcode`\^=\other
- \catcode`\_=\other
- \catcode`\|=\other
- \catcode`\<=\other
- \catcode`\>=\other
- \catcode`\+=\other
- \catcode`\$=\other
- \def\normaldoublequote{"}
- \def\normaltilde{~}
- \def\normalcaret{^}
- \def\normalunderscore{_}
- \def\normalverticalbar{|}
- \def\normalless{<}
- \def\normalgreater{>}
- \def\normalplus{+}
- \def\normaldollar{$}%$ font-lock fix
