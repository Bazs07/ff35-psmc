+   const CGEN_KEYWORD_ENTRY *ke;
+ 
+   ke = cgen_keyword_lookup_value (keyword_table, value);
+   if (ke != NULL)
+     (*info->fprintf_func) (info->stream, "%s", ke->name);
+   else
+     (*info->fprintf_func) (info->stream, "???");
