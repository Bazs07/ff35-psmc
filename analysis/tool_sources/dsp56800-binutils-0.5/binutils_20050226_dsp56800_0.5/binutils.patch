+ static reloc_howto_type * dsp56800_reloc_type_lookup
+   PARAMS ((bfd *abfd, bfd_reloc_code_real_type code));
+ static void elf_dsp56800_info_to_howto_rel
+   PARAMS ((bfd *, arelent *, Elf_Internal_Rela *));
+ 
+ /* Set the howto pointer for an DSP56800 ELF reloc.  */
+ static void
+ elf_dsp56800_info_to_howto_rel (abfd, cache_ptr, dst)
+      bfd *abfd ATTRIBUTE_UNUSED;
+      arelent *cache_ptr;
+      Elf_Internal_Rela *dst;
+ {
+   unsigned int r_type;
+ 
+   r_type = ELF32_R_TYPE (dst->r_info);
+   BFD_ASSERT (r_type < (unsigned int) R_DSP56800_max);
+   cache_ptr->howto = & dsp56800_elf_howto_table [r_type];
+ }
+ 
+ 
+ /* Map BFD reloc types to DSP56800 ELF reloc types.  */
+ 
+ struct dsp56800_reloc_map
+ {
+   bfd_reloc_code_real_type bfd_reloc_val;
+   unsigned int dsp56800_reloc_val;
+ };
+ 
+ static const struct dsp56800_reloc_map dsp56800_reloc_map [] =
+ {
+   { BFD_RELOC_NONE,              R_DSP56800_NONE   },
+   { BFD_RELOC_DSP56800_ADDR7,    R_DSP56800_ADDR7  },
+   { BFD_RELOC_DSP56800_ADDR7W2,  R_DSP56800_ADDR7W2  },
+   { BFD_RELOC_DSP56800_ADDR7W3,  R_DSP56800_ADDR7W3  },
+   { BFD_RELOC_DSP56800_MASK8W2,  R_DSP56800_MASK8W2  },
+   { BFD_RELOC_DSP56800_MASK8W3,  R_DSP56800_MASK8W3  },
+   { BFD_RELOC_DSP56800_ADDR16W2, R_DSP56800_ADDR16W2 },
+   { BFD_RELOC_DSP56800_ADDR16W3, R_DSP56800_ADDR16W3 },
+   /* This is to handle .word expresions with label symbols */
+   { BFD_RELOC_16,                R_DSP56800_CONSTWORD },
+   /* This is to handle .4byte expressions with label symbols */
+   { BFD_RELOC_32,                R_DSP56800_CONSTDWORD },
+   { BFD_RELOC_VTABLE_INHERIT,    R_DSP56800_GNU_VTINHERIT },
+   { BFD_RELOC_VTABLE_ENTRY,      R_DSP56800_GNU_VTENTRY },
+ };
+ 
+ static reloc_howto_type *
+ dsp56800_reloc_type_lookup (abfd, code)
+      bfd *abfd ATTRIBUTE_UNUSED;
+      bfd_reloc_code_real_type code;
+ {
+   unsigned int i;
+ 
+   for (i = sizeof (dsp56800_reloc_map) / sizeof (dsp56800_reloc_map[0]);
+        --i;)
+     if (dsp56800_reloc_map [i].bfd_reloc_val == code)
+       return & dsp56800_elf_howto_table [dsp56800_reloc_map[i].dsp56800_reloc_val];
+ 
+   return NULL;
+ }
