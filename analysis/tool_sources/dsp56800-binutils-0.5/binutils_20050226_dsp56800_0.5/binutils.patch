+      arelent *reloc_entry;
+      asymbol *symbol;
+      PTR data ATTRIBUTE_UNUSED;
+      asection *input_section;
+      bfd *output_bfd;
+      char **error_message ATTRIBUTE_UNUSED;
+ {
+   return
+ 	 dsp56800_elf_reloc (input_bfd, reloc_entry,	symbol, data, input_section,
+ 								output_bfd,	error_message,	1);
+ }
+ 
+ bfd_reloc_status_type
+ dsp56800_elf_w3_reloc (input_bfd,
+ 							  reloc_entry,
+ 							  symbol,
+ 							  data,
+ 							  input_section,
+ 							  output_bfd,
+ 							  error_message)
