+ 
+         ;; lsr
+         FDD lsr
+ 
+         ;; lsrac
+         F_LAST_2_OP_REGS lsrac
+ 
+         ;; lsrr
+         FDD_LAST_2_OP_REGS lsrr
+ 
+         ;; mac                
