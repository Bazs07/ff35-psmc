- {
-   \catcode`^ = \active
-   \catcode`< = \active
-   \catcode`> = \active
-   \catcode`+ = \active
-   \gdef\mathactive{%
-     \let^ = \ptexhat
-     \let< = \ptexless
-     \let> = \ptexgtr
-     \let+ = \ptexplus
-   }
- }
