+        \opc \par X:(R1)+N,\reg
+        \opc \par X:(R2)+N,\reg
+        \opc \par X:(R3)+N,\reg
+        \opc \par \reg,X:(R0)+N
+        \opc \par \reg,X:(R1)+N
+        \opc \par \reg,X:(R2)+N
+        \opc \par \reg,X:(R3)+N
+ .endm
